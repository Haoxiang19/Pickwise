# Copy to .env and fill in. Never commit .env. With a variable left empty, that service runs as a labelled mock.

# Model, OpenAI-compatible chat completions
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=
# Optional JSON object merged into every model request body, e.g. {"thinking": {"type": "disabled"}}
LLM_EXTRA_BODY=

# Product search
CHANNEL3_API_KEY=

# PayPal sandbox (the base URL is fixed to the sandbox in code)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Public URL of the app, used for PayPal return/cancel URLs, e.g. https://your-app.onrender.com
APP_BASE_URL=

# Listed in the requirements; not used yet (see docs/progress.md)
SNAPSHOT_MODE=
